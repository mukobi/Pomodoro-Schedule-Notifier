<Window x:Class="PomodoroScheduleNotifier.BreakReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Break Reminder"
        Width="900"
        MinHeight="560"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        Foreground="#F4F1E8"
        FontFamily="Bahnschrift">
    <Window.Resources>
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#00000000"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#18FFFFFF"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#55FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#0D0E0E"
            BorderBrush="#2E332F"
            BorderThickness="1"
            MinHeight="560"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="42" ShadowDepth="6" Opacity="0.38" Color="#000000"/>
        </Border.Effect>

        <Grid ClipToBounds="True">
            <Border x:Name="BreakArtworkBackground"
                    Background="#111412"
                    Opacity="0.18"/>

            <Rectangle Fill="#D60D0E0E"/>

            <Image x:Name="BreakArtworkImage"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   MaxWidth="780"
                   MaxHeight="420"
                   Margin="40,78,40,92"
                   Opacity="0.92"
                   Stretch="Uniform"
                   IsHitTestVisible="False"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <TextBlock x:Name="BreakMessageIconText"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="Bahnschrift"
                       FontSize="168"
                       FontWeight="SemiBold"
                       Foreground="#F4F1E8"
                       Opacity="0.16"
                       Text="-&gt;"
                       TextAlignment="Center"/>

            <Rectangle Height="230"
                       VerticalAlignment="Bottom">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#000D0E0E" Offset="0"/>
                        <GradientStop Color="#D90D0E0E" Offset="0.64"/>
                        <GradientStop Color="#F20D0E0E" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Grid Margin="38">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Margin="0,2,0,0"
                            HorizontalAlignment="Center"
                            TextBlock.TextAlignment="Center">
                    <Grid Width="620"
                          Height="38"
                          ToolTip="Current time block and long breaks">
                        <Rectangle Height="15"
                                   Fill="#232724"
                                   Stroke="#33FFFFFF"
                                   StrokeThickness="1"
                                   VerticalAlignment="Center"/>
                        <Rectangle x:Name="PeriodProgressFill"
                                   Height="15"
                                   Fill="#D8C24B"
                                   VerticalAlignment="Center"
                                   RenderTransformOrigin="0,0.5">
                            <Rectangle.RenderTransform>
                                <ScaleTransform x:Name="PeriodProgressFillScale" ScaleX="0"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <Canvas x:Name="LongBreakTickCanvas"
                                Width="620"
                                Height="38"
                                IsHitTestVisible="False"/>
                    </Grid>
                    <Canvas x:Name="ProgressLabelCanvas"
                            Width="620"
                            Height="18"
                            Margin="0,1,0,0"
                            IsHitTestVisible="False"/>
                </StackPanel>

                <Button Grid.Row="0"
                        HorizontalAlignment="Right"
                        Style="{StaticResource CloseButtonStyle}"
                        ToolTip="Dismiss"
                        Click="DismissButton_Click">
                    <Grid Width="18" Height="18" RenderOptions.EdgeMode="Aliased">
                        <Rectangle Width="18"
                                   Height="2"
                                   Fill="#D7DBD2"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <RotateTransform Angle="45"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Width="18"
                                   Height="2"
                                   Fill="#D7DBD2"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <RotateTransform Angle="-45"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                </Button>

                <StackPanel Grid.Row="1"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,4"
                            TextBlock.TextAlignment="Center">
                    <TextBlock x:Name="PhaseText"
                               Margin="0,0,0,8"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="#B9BEB5"
                               Text="short break"/>

                    <TextBlock x:Name="BreakMessageText"
                               FontSize="74"
                               FontWeight="SemiBold"
                               Foreground="#F7F2E6"
                               LineHeight="80"
                               MaxWidth="760"
                               Text="STEP AWAY"
                               TextAlignment="Center"
                               TextWrapping="Wrap">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.82" Color="#000000"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <Rectangle x:Name="BreakMessageAccentLine"
                               Width="220"
                               Height="3"
                               Margin="0,16,0,0"
                               Fill="#3A3A35"/>
                </StackPanel>

                <UniformGrid Grid.Row="2"
                             Columns="4"
                             Width="760"
                             HorizontalAlignment="Center"
                             Margin="0,28,0,0">
                    <StackPanel Margin="8,0">
                        <TextBlock FontSize="25" FontWeight="SemiBold" Text="get up" TextAlignment="Center"/>
                        <TextBlock Margin="0,6,0,0" FontSize="16" Foreground="#B9BEB5" Text="off the chair" TextAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Margin="8,0">
                        <TextBlock FontSize="25" FontWeight="SemiBold" Text="look far" TextAlignment="Center"/>
                        <TextBlock Margin="0,6,0,0" FontSize="16" Foreground="#B9BEB5" Text="20+ ft / 20 sec" TextAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Margin="8,0">
                        <TextBlock FontSize="25" FontWeight="SemiBold" Text="blink" TextAlignment="Center"/>
                        <TextBlock Margin="0,6,0,0" FontSize="16" Foreground="#B9BEB5" Text="10 slow reps" TextAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Margin="8,0">
                        <TextBlock FontSize="25" FontWeight="SemiBold" Text="stretch" TextAlignment="Center"/>
                        <TextBlock x:Name="StretchTargetText"
                                   Margin="0,6,0,0"
                                   FontSize="16"
                                   Foreground="#B9BEB5"
                                   Text="neck + traps"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </UniformGrid>
            </Grid>
        </Grid>
    </Border>
</Window>
