<Window x:Class="PomodoroScheduleNotifier.BreakReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Break Reminder"
        Width="760"
        MinHeight="460"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        Foreground="#F4F1E8"
        FontFamily="Bahnschrift">
    <Window.Resources>
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#00000000"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#18FFFFFF"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#55FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#101111"
            BorderBrush="#363A35"
            BorderThickness="1"
            MinHeight="460"
            Padding="42">
        <Border.Effect>
            <DropShadowEffect BlurRadius="42" ShadowDepth="6" Opacity="0.38" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0"
                    HorizontalAlignment="Right"
                    Style="{StaticResource CloseButtonStyle}"
                    ToolTip="Dismiss"
                    Click="DismissButton_Click">
                <Grid Width="18" Height="18" RenderOptions.EdgeMode="Aliased">
                    <Rectangle Width="18"
                               Height="2"
                               Fill="#D7DBD2"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5">
                        <Rectangle.RenderTransform>
                            <RotateTransform Angle="45"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <Rectangle Width="18"
                               Height="2"
                               Fill="#D7DBD2"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5">
                        <Rectangle.RenderTransform>
                            <RotateTransform Angle="-45"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Grid>
            </Button>

            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        TextBlock.TextAlignment="Center">
                <StackPanel Margin="0,0,0,34"
                            HorizontalAlignment="Center">
                    <Grid Width="500"
                          Height="34"
                          ToolTip="Current time block and next long break">
                        <Rectangle Height="9"
                                   Fill="#2A2D2A"
                                   VerticalAlignment="Center"/>
                        <Rectangle Height="9"
                                   Fill="#D8C24B"
                                   VerticalAlignment="Center"
                                   RenderTransformOrigin="0,0.5">
                            <Rectangle.RenderTransform>
                                <ScaleTransform x:Name="PeriodProgressFillScale" ScaleX="0"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Width="4"
                                   Height="30"
                                   Fill="#F4F1E8"
                                   HorizontalAlignment="Left">
                            <Rectangle.RenderTransform>
                                <TranslateTransform x:Name="NextLongBreakMarkerTransform"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                    <Grid Width="500" Margin="0,2,0,0">
                        <TextBlock x:Name="PeriodStartText"
                                   HorizontalAlignment="Left"
                                   FontSize="13"
                                   Foreground="#858B83"
                                   Text="9"/>
                        <TextBlock x:Name="NextLongBreakText"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   Foreground="#B9BEB5"
                                   Text="12"/>
                        <TextBlock x:Name="PeriodEndText"
                                   HorizontalAlignment="Right"
                                   FontSize="13"
                                   Foreground="#858B83"
                                   Text="18"/>
                    </Grid>
                </StackPanel>

                <TextBlock x:Name="PhaseText"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="#B9BEB5"
                           Text="short break"/>
                <Grid Margin="0,12,0,0"
                      HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="BreakMessageIconBorder"
                            Grid.Column="0"
                            Width="52"
                            Height="52"
                            Background="#3A3A35"
                            ClipToBounds="True"
                            CornerRadius="8"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="BreakMessageIconText"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Bahnschrift"
                                   FontSize="23"
                                   FontWeight="SemiBold"
                                   Foreground="#F4F1E8"
                                   Text="-&gt;"
                                   TextAlignment="Center"/>
                    </Border>

                    <TextBlock Grid.Column="2"
                               x:Name="BreakMessageText"
                               FontSize="62"
                               FontWeight="SemiBold"
                               LineHeight="66"
                               MaxWidth="570"
                               Text="step away"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </Grid>

                <UniformGrid Columns="4"
                             Margin="0,38,0,0"
                             Width="650">
                    <StackPanel>
                        <TextBlock FontSize="24" FontWeight="SemiBold" Text="get up"/>
                        <TextBlock Margin="0,6,0,0" FontSize="16" Foreground="#B9BEB5" Text="off the chair"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock FontSize="24" FontWeight="SemiBold" Text="look far"/>
                        <TextBlock Margin="0,6,0,0" FontSize="16" Foreground="#B9BEB5" Text="20+ ft / 20 sec"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock FontSize="24" FontWeight="SemiBold" Text="blink"/>
                        <TextBlock Margin="0,6,0,0" FontSize="16" Foreground="#B9BEB5" Text="10 slow reps"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock FontSize="24" FontWeight="SemiBold" Text="stretch"/>
                        <TextBlock x:Name="StretchTargetText"
                                   Margin="0,6,0,0"
                                   FontSize="16"
                                   Foreground="#B9BEB5"
                                   Text="neck + traps"/>
                    </StackPanel>
                </UniformGrid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
