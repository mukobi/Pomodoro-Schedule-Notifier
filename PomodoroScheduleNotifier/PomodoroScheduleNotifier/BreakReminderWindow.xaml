<Window x:Class="PomodoroScheduleNotifier.BreakReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Break Reminder"
        Width="900"
        MinHeight="560"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        Foreground="#F4F1E8"
        FontFamily="Bahnschrift">
    <Window.Resources>
        <Style x:Key="ReminderMetricPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#8A070808"/>
            <Setter Property="BorderBrush" Value="#28FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="6,0"/>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#00000000"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#18FFFFFF"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#55FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#101111"
            BorderBrush="#363A35"
            BorderThickness="1"
            MinHeight="560"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="42" ShadowDepth="6" Opacity="0.38" Color="#000000"/>
        </Border.Effect>

        <Grid ClipToBounds="True">
            <Border x:Name="BreakArtworkBackground"
                    Background="#151715"/>

            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F00A0B0B" Offset="0"/>
                        <GradientStop Color="#D30A0B0B" Offset="0.48"/>
                        <GradientStop Color="#8F0A0B0B" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Rectangle x:Name="BreakMessageAccentWash"
                       Width="390"
                       HorizontalAlignment="Right"
                       Fill="#3A3A35"
                       Opacity="0.22"/>

            <Image x:Name="BreakArtworkImage"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   MaxWidth="590"
                   MaxHeight="525"
                   Margin="260,22,34,28"
                   Opacity="0.72"
                   Stretch="Uniform"
                   IsHitTestVisible="False"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <TextBlock x:Name="BreakMessageIconText"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,82,0"
                       FontFamily="Bahnschrift"
                       FontSize="168"
                       FontWeight="SemiBold"
                       Foreground="#F4F1E8"
                       Opacity="0.12"
                       Text="-&gt;"
                       TextAlignment="Center"/>

            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#E80B0C0C" Offset="0"/>
                        <GradientStop Color="#C20B0C0C" Offset="0.58"/>
                        <GradientStop Color="#330B0C0C" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Rectangle Height="170"
                       VerticalAlignment="Bottom">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#000A0B0B" Offset="0"/>
                        <GradientStop Color="#E80A0B0B" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Grid Margin="38">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0"
                            Margin="0,2,0,0"
                            HorizontalAlignment="Center"
                            TextBlock.TextAlignment="Center">
                    <Grid Width="620"
                          Height="38"
                          ToolTip="Current time block and long breaks">
                        <Rectangle Height="15"
                                   Fill="#232724"
                                   Stroke="#33FFFFFF"
                                   StrokeThickness="1"
                                   VerticalAlignment="Center"/>
                        <Rectangle x:Name="PeriodProgressFill"
                                   Height="15"
                                   Fill="#D8C24B"
                                   VerticalAlignment="Center"
                                   RenderTransformOrigin="0,0.5">
                            <Rectangle.RenderTransform>
                                <ScaleTransform x:Name="PeriodProgressFillScale" ScaleX="0"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <Canvas x:Name="LongBreakTickCanvas"
                                Width="620"
                                Height="38"
                                IsHitTestVisible="False"/>
                    </Grid>
                    <Canvas x:Name="ProgressLabelCanvas"
                            Width="620"
                            Height="18"
                            Margin="0,1,0,0"
                            IsHitTestVisible="False"/>
                </StackPanel>

                <Button Grid.Row="0"
                        HorizontalAlignment="Right"
                        Style="{StaticResource CloseButtonStyle}"
                        ToolTip="Dismiss"
                        Click="DismissButton_Click">
                    <Grid Width="18" Height="18" RenderOptions.EdgeMode="Aliased">
                        <Rectangle Width="18"
                                   Height="2"
                                   Fill="#D7DBD2"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <RotateTransform Angle="45"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Width="18"
                                   Height="2"
                                   Fill="#D7DBD2"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <RotateTransform Angle="-45"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                </Button>

                <Grid Grid.Row="1"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <Rectangle x:Name="BreakMessageAccentBar"
                               Width="6"
                               Height="178"
                               Fill="#3A3A35"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"/>

                    <Border Margin="14,0,0,0"
                            MinHeight="190"
                            Width="760"
                            Padding="34,25"
                            Background="#B3080909"
                            BorderBrush="#42FFFFFF"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="26" ShadowDepth="4" Opacity="0.48" Color="#000000"/>
                        </Border.Effect>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    TextBlock.TextAlignment="Center">
                            <TextBlock x:Name="PhaseText"
                                       Margin="0,0,0,10"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="#B9BEB5"
                                       Text="short break"/>

                            <TextBlock x:Name="BreakMessageText"
                                       FontSize="74"
                                       FontWeight="SemiBold"
                                       Foreground="#F7F2E6"
                                       LineHeight="80"
                                       MaxWidth="690"
                                       Text="STEP AWAY"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.7" Color="#000000"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>

                <UniformGrid Grid.Row="2"
                             Columns="4"
                             Width="760"
                             HorizontalAlignment="Center"
                             Margin="0,30,0,0">
                    <Border Style="{StaticResource ReminderMetricPanelStyle}">
                        <StackPanel>
                            <TextBlock FontSize="25" FontWeight="SemiBold" Text="get up" TextAlignment="Center"/>
                            <TextBlock Margin="0,6,0,0" FontSize="16" Foreground="#B9BEB5" Text="off the chair" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ReminderMetricPanelStyle}">
                        <StackPanel>
                            <TextBlock FontSize="25" FontWeight="SemiBold" Text="look far" TextAlignment="Center"/>
                            <TextBlock Margin="0,6,0,0" FontSize="16" Foreground="#B9BEB5" Text="20+ ft / 20 sec" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ReminderMetricPanelStyle}">
                        <StackPanel>
                            <TextBlock FontSize="25" FontWeight="SemiBold" Text="blink" TextAlignment="Center"/>
                            <TextBlock Margin="0,6,0,0" FontSize="16" Foreground="#B9BEB5" Text="10 slow reps" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ReminderMetricPanelStyle}">
                        <StackPanel>
                            <TextBlock FontSize="25" FontWeight="SemiBold" Text="stretch" TextAlignment="Center"/>
                            <TextBlock x:Name="StretchTargetText"
                                       Margin="0,6,0,0"
                                       FontSize="16"
                                       Foreground="#B9BEB5"
                                       Text="neck + traps"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>
        </Grid>
    </Border>
</Window>
