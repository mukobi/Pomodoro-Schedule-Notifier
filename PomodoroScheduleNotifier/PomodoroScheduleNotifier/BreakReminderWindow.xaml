<Window x:Class="PomodoroScheduleNotifier.BreakReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Break Reminder"
        Width="720"
        MinHeight="720"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        Foreground="#F4F1E8"
        FontFamily="Agency FB">
    <Window.Resources>
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#00000000"/>
            <Setter Property="BorderBrush" Value="#24FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#18FFFFFF"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#55FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#0C0D0D"
            BorderBrush="#30352F"
            BorderThickness="1"
            MinHeight="720"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="46" ShadowDepth="7" Opacity="0.42" Color="#000000"/>
        </Border.Effect>

        <Grid ClipToBounds="True">
            <Border x:Name="BreakArtworkBackground"
                    Background="#111412"/>

            <Rectangle Fill="#30080909"/>

            <TextBlock x:Name="BreakMessageIconText"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="190"
                       FontWeight="SemiBold"
                       Foreground="#F4F1E8"
                       Opacity="0.18"
                       Text="-&gt;"
                       TextAlignment="Center"/>

            <Rectangle Height="190"
                       VerticalAlignment="Top">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#A80C0D0D" Offset="0"/>
                        <GradientStop Color="#580C0D0D" Offset="0.58"/>
                        <GradientStop Color="#000C0D0D" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Rectangle Height="300"
                       VerticalAlignment="Bottom">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#000C0D0D" Offset="0"/>
                        <GradientStop Color="#940C0D0D" Offset="0.52"/>
                        <GradientStop Color="#CC0C0D0D" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Grid Margin="36">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel Width="560"
                                HorizontalAlignment="Center"
                                TextBlock.TextAlignment="Center">
                        <TextBlock x:Name="PhaseText"
                                   Margin="0,0,0,8"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="#D8DED4"
                                   Text="SHORT BREAK"/>

                        <Grid Height="39"
                              ToolTip="Current time block and long breaks">
                            <Rectangle Height="16"
                                       Fill="#252A26"
                                       Stroke="#42FFFFFF"
                                       StrokeThickness="1"
                                       VerticalAlignment="Center"/>
                            <Rectangle x:Name="PeriodProgressFill"
                                       Height="16"
                                       Fill="#D8C24B"
                                       VerticalAlignment="Center"
                                       RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform x:Name="PeriodProgressFillScale" ScaleX="0"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Canvas x:Name="LongBreakTickCanvas"
                                    Width="560"
                                    Height="39"
                                    IsHitTestVisible="False"/>
                        </Grid>
                        <Canvas x:Name="ProgressLabelCanvas"
                                Width="560"
                                Height="18"
                                Margin="0,1,0,0"
                                IsHitTestVisible="False"/>
                    </StackPanel>

                    <Button HorizontalAlignment="Right"
                            Style="{StaticResource CloseButtonStyle}"
                            ToolTip="Dismiss"
                            Click="DismissButton_Click">
                        <Grid Width="17" Height="17" RenderOptions.EdgeMode="Aliased">
                            <Rectangle Width="17"
                                       Height="2"
                                       Fill="#D7DBD2"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform>
                                    <RotateTransform Angle="45"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            <Rectangle Width="17"
                                       Height="2"
                                       Fill="#D7DBD2"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform>
                                    <RotateTransform Angle="-45"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                    </Button>
                </Grid>

                <StackPanel Grid.Row="2"
                            HorizontalAlignment="Center"
                            TextBlock.TextAlignment="Center">
                    <TextBlock x:Name="BreakMessageText"
                               FontSize="92"
                               FontWeight="SemiBold"
                               Foreground="#F7F2E6"
                               LineHeight="94"
                               MaxWidth="630"
                               Text="STEP AWAY"
                               TextAlignment="Center"
                               TextWrapping="Wrap">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="28" ShadowDepth="2" Opacity="0.95" Color="#000000"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <Rectangle x:Name="BreakMessageAccentLine"
                               Width="210"
                               Height="3"
                               Margin="0,14,0,22"
                               Fill="#3A3A35"/>

                    <UniformGrid Columns="4"
                                 Width="630">
                        <StackPanel Margin="6,0">
                            <TextBlock FontSize="24" FontWeight="SemiBold" Text="GET UP" TextAlignment="Center"/>
                            <TextBlock Margin="0,5,0,0" FontSize="17" Foreground="#B9BEB5" Text="OFF THE CHAIR" TextAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Margin="6,0">
                            <TextBlock FontSize="24" FontWeight="SemiBold" Text="LOOK FAR" TextAlignment="Center"/>
                            <TextBlock Margin="0,5,0,0" FontSize="17" Foreground="#B9BEB5" Text="20 FT / 20 SEC" TextAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Margin="6,0">
                            <TextBlock FontSize="24" FontWeight="SemiBold" Text="BLINK" TextAlignment="Center"/>
                            <TextBlock Margin="0,5,0,0" FontSize="17" Foreground="#B9BEB5" Text="10 SLOW REPS" TextAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Margin="6,0">
                            <TextBlock FontSize="24" FontWeight="SemiBold" Text="STRETCH" TextAlignment="Center"/>
                            <TextBlock x:Name="StretchTargetText"
                                       Margin="0,5,0,0"
                                       FontSize="17"
                                       Foreground="#B9BEB5"
                                       Text="NECK + TRAPS"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
